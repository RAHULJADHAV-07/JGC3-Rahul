# Copy to .env for local overrides. DEVELOPMENT ONLY — nothing in this file is
# read by a deployed build.
#
# A production build has no API address in it at all. It calls /api on whatever
# origin served the page, and that origin forwards to the backend:
#
#   Vercel  →  api/[...path].js forwards to API_ORIGIN, set in
#              Vercel → Settings → Environment Variables
#   Docker  →  nginx.conf proxies /api to the backend container
#
# That is the only arrangement the httpOnly session cookie and the
# connect-src 'self' CSP in vercel.json will both accept — see frontend/DEPLOY.md.

# Dev server port — change to switch ports easily.
VITE_PORT=5173

# Dev-only: where the Vite proxy forwards /api during `npm run dev`.
# Keep in sync with the backend's API_PORT.
VITE_API_PROXY=http://localhost:8000

# Dev-only escape hatch: call an API somewhere other than the Vite proxy, e.g.
# to work against a deployed backend. IGNORED by `npm run build` output — a
# built app always uses same-origin /api, so a value left behind in a hosting
# dashboard can no longer take the site down.
VITE_API_URL=
